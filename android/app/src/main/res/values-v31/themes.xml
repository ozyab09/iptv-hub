<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen Android 12+ (API 31). Библиотека androidbrowserhelper уже
  поднимает TWA-сплэш на старых версиях; здесь описан системный splash,
  который рисует сама платформа: наш знак на тёмном фоне приложения.
  Файл только для v31+, чтобы не тянуть атрибуты API 31 в minSdk 24.

  «Пост-темы» здесь нет намеренно: соответствующий атрибут принадлежит
  библиотеке androidx.core:core-splashscreen и пишется без префикса android:.
  В платформенной теме его не существует, и aapt2 падает на линковке
  ресурсов. Отдельная тема и не нужна: у LauncherTheme уже правильный
  windowBackground.
-->
<resources>
    <style name="LauncherTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/system_bar</item>
        <item name="android:navigationBarColor">@color/system_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_splash</item>
    </style>
</resources>
