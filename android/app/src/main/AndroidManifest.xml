<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Тема вместо Theme.Translucent: фон окна совпадает с background_color
      манифеста (запуск без белой вспышки), бары выкрашены в тон приложения,
      а Android 12+ получает системный splash (values-v31/themes.xml).
      Иконка — adaptive (@mipmap/ic_launcher), подпись — @string/app_name.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/LauncherTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/LauncherTheme">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://ozyab09.github.io/iptv-hub/" />

            <!-- Цвета системных баров задаёт и тема; метаданные нужны
                 клиенту Custom Tabs, который рисует окно на Android 11-. -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/system_bar" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/system_bar" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ссылки https://ozyab09.github.io/iptv-hub/... открываются в приложении. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ozyab09.github.io"
                    android:pathPrefix="/iptv-hub/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
