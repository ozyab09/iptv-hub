<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Тема вместо Theme.Translucent: фон окна совпадает с background_color
      манифеста (запуск без белой вспышки), бары выкрашены в тон приложения,
      а Android 12+ получает системный splash (values-v31/themes.xml).
      Иконка — adaptive (@mipmap/ic_launcher), подпись — @string/app_name.
      asset_statements — связь приложения с сайтом из Integration Guide.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/LauncherTheme">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!--
          Режим запуска намеренно оставлен по умолчанию: androidbrowserhelper
          стартует TWA в новой задаче (FLAG_ACTIVITY_NEW_TASK) и не
          переопределяет onNewIntent, поэтому singleTask ломал бы повторный
          запуск — окно Chrome поверх могло исчезнуть, а deep-link не сработать.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/LauncherTheme">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://ozyab09.github.io/iptv-hub/" />

            <!--
              Цвета системных баров для окна TWA, которое рисует Chrome.
              *_DARK важны: дефолт в библиотеке — белый, и в тёмной системной
              теме бары уезжали бы в белый. У ключа разделителя навигации
              опечатка «androix» — она в самой библиотеке, так и должно быть.
            -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/system_bar" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/system_bar" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/system_bar" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/system_bar" />
            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/system_bar" />
            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR_DARK"
                android:resource="@color/system_bar" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ссылки https://ozyab09.github.io/iptv-hub/... открываются в приложении. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ozyab09.github.io"
                    android:pathPrefix="/iptv-hub/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
