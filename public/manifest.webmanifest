{
  "name": "IPTV Hub",
  "short_name": "IPTV Hub",
  "description": "Self-hosted веб-плеер для IPTV-плейлистов с телепрограммой",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c0d10",
